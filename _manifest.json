{
  "manifest_version": 2,
  "id": "local.maibot-bililife",
  "version": "0.2.6",
  "name": "麦麦的 B 站生活",
  "description": "钟面日程、模块独立配置、TOML、模型直选与可干预的兴趣记忆。默认不自动发布。",
  "author": {"name": "ANTINOVIA", "url": "https://github.com/ANTINOVIA"},
  "urls": {"repository": "https://github.com/ANTINOVIA/maibot-bililife", "homepage": "https://github.com/ANTINOVIA/maibot-bililife", "documentation": "https://github.com/ANTINOVIA/maibot-bililife#readme", "issues": "https://github.com/ANTINOVIA/maibot-bililife/issues"},
  "license": "MIT",
  "host_application": {"min_version": "1.3.14", "max_version": "1.3.14"},
  "sdk": {"min_version": "2.16.0", "max_version": "2.16.0"},
  "capabilities": ["config.get", "llm.generate", "llm.get_available_models", "llm.transcribe_audio", "maisaka.context.append", "send.text"],
  "dependencies": [
    {"type": "python_package", "name": "bilibili-api-python", "version_spec": "==17.4.2"},
    {"type": "python_package", "name": "httpx", "version_spec": "==0.28.1"},
    {"type": "python_package", "name": "qrcode", "version_spec": "==8.2"},
    {"type": "python_package", "name": "Pillow", "version_spec": ">=10"},
    {"type": "python_package", "name": "aiohttp", "version_spec": ">=3.10,<4"}
  ],
  "i18n": {"default_locale": "zh-CN", "supported_locales": ["zh-CN"]}
}
